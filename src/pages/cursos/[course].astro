---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const [courses, lessons] = await Promise.all([
    getCollection('courses'),
    getCollection('lessons'),
  ]);

  return courses.map((course) => ({
    params: { course: course.id },
    props: {
      course,
      lessons: lessons
        .filter((lesson) => lesson.data.course === course.id)
        .sort((a, b) => a.data.order - b.data.order),
    },
  }));
}

interface Props {
  course: CollectionEntry<'courses'>;
  lessons: CollectionEntry<'lessons'>[];
}

const { course, lessons } = Astro.props;

// Cada unidad declarada en el frontmatter se muestra en un desplegable con su nombre.
const unidades = new Map<string, CollectionEntry<'lessons'>[]>();
const leccionesSinUnidad: CollectionEntry<'lessons'>[] = [];

for (const lesson of lessons) {
  const nombreUnidad = lesson.data.unit;

  if (!nombreUnidad) {
    leccionesSinUnidad.push(lesson);
    continue;
  }

  const grupo = unidades.get(nombreUnidad);
  if (grupo) {
    grupo.push(lesson);
  } else {
    unidades.set(nombreUnidad, [lesson]);
  }
}

const desplegables = Array.from(unidades, ([nombre, grupo]) => ({
  nombre,
  lecciones: grupo,
}));
---

<BaseLayout title={`${course.data.title} | Grumpy's Academy`} description={course.data.description}>
  <main id="contenido" class="container page-main">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/cursos/">Cursos</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{course.data.title}</span>
    </nav>
    <h1>{course.data.title}</h1>
    <p>{course.data.description}</p>
    <h2>Lecciones</h2>
    {
      desplegables.map(({ nombre, lecciones }) => (
        <details class="course-units">
          <summary>{nombre}</summary>
          <ol class="resource-list">
            {lecciones.map((lesson) => (
              <li>
                <a href={`/cursos/${course.id}/${lesson.id}/`}>{lesson.data.title}</a>
                <p>{lesson.data.description}</p>
              </li>
            ))}
          </ol>
        </details>
      ))
    }
    {
      leccionesSinUnidad.length > 0 && (
        <ol class="resource-list">
          {leccionesSinUnidad.map((lesson) => (
            <li>
              <a href={`/cursos/${course.id}/${lesson.id}/`}>{lesson.data.title}</a>
              <p>{lesson.data.description}</p>
            </li>
          ))}
        </ol>
      )
    }
  </main>
</BaseLayout>
